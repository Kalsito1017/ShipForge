# Copy to .env and fill in values. Never commit .env.

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://shipment:shipment@localhost:5432/shipment

# Redis (Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0

# MinIO (artifact storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artifacts
MINIO_SECURE=false

# JWT authentication (generate a strong random value, e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# AI Incident Assistant (OpenAI-compatible; leave empty to use offline mock mode)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Artifacts
ARTIFACT_MAX_SIZE_MB=100
